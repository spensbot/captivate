{
  "main": "./src/main/main.ts",
  "scripts": {
    "build": "npm-run-all --parallel build:main build:renderer build:visualizer",
    "build:projectm-bridge": "node tools/run-projectm-node-gyp.js",
    "prepare:projectm-bridge": "node tools/prepare_projectm_bridge.js",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "build:visualizer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.visualizer.prod.ts",
    "postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && patch-package && cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "prepare:node-link": "node tools/prepare_node_link_runtime.js",
    "check:build-env": "node tools/check-build-environment.js",
    "package:bundle": "node tools/run-with-qualified-node.cjs -- npm run package:bundle:inner",
    "package:bundle:inner": "node tools/run-with-qualified-node.cjs -- npm run __package:bundle:inner",
    "__package:bundle:inner": "node tools/check-build-environment.js && ts-node ./.erb/scripts/clean.js dist && npm run prepare:projectm-bridge && npm run prepare:node-link && npm run rebuild && npm run build",
    "package": "npm run package:bundle && electron-builder build --publish never",
    "package:installer-only": "node tools/run-with-qualified-node.cjs -- node tools/run-electron-builder-installer.cjs",
    "package:win": "npm run package:bundle && electron-builder build --win --publish never",
    "package:linux": "npm run package:bundle && electron-builder build --linux --publish never",
    "package:mac": "npm run package:bundle && electron-builder build --mac --publish never",
    "rebuild": "node -r ts-node/register/transpile-only ./.erb/scripts/electron-rebuild.js",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development electronmon -r ts-node/register/transpile-only .",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "start:visualizer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.visualizer.dev.ts",
    "qlc_fixture_parse": "ts-node tools/qlc_fixture_parser/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:node-link": "npm --prefix release/app/node-link install --ignore-scripts && npm --prefix release/app/node-link run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:node-link"
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "overrides": [
      {
        "files": [
          ".prettierrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@leeoniya/ufuzzy": "^1.0.18",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@reduxjs/toolkit": "^2.11.2",
    "address": "^2.0.1",
    "deep-equal": "^2.0.5",
    "electron-debug": "^3.2.0",
    "ffmpeg-static": "^5.3.0",
    "koffi": "^2.8.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.throttle": "^4.1.1",
    "multicast-dns": "^7.2.5",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-undo": "^1.0.1",
    "styled-components": "^5.3.5",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.6",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.1",
    "@types/color-convert": "^2.0.0",
    "@types/core-js": "^2.5.5",
    "@types/deep-equal": "^1.0.1",
    "@types/jest": "^27.5.1",
    "@types/lodash.clonedeep": "^4.5.7",
    "@types/lodash.throttle": "^4.1.7",
    "@types/multicast-dns": "^7.2.1",
    "@types/node": "^25.5.2",
    "@types/node-dir": "^0.0.34",
    "@types/path-browserify": "^1.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/regenerator-runtime": "^0.13.1",
    "@types/serialport": "^8.0.2",
    "@types/styled-components": "^5.1.25",
    "@types/terser-webpack-plugin": "^5.0.4",
    "@types/three": "^0.183.1",
    "@types/webpack-bundle-analyzer": "^4.4.1",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "core-js": "^3.22.5",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^3.4.1",
    "detect-port": "^1.3.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^3.2.0",
    "electron-notarize": "^1.2.1",
    "electronmon": "^2.0.2",
    "fast-xml-parser": "^4.1.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.6",
    "i": "^0.3.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^28.1.0",
    "jest-environment-jsdom": "^28.1.0",
    "lint-staged": "^12.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "node-addon-api": "^8.7.0",
    "node-dir": "^0.1.17",
    "node-gyp": "^12.2.0",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "prettier": "^2.6.2",
    "raw-loader": "^4.0.2",
    "react-refresh": "^0.13.0",
    "rimraf": "^3.0.2",
    "sass": "^1.99.0",
    "sass-loader": "^12.6.0",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.4.0",
    "ts-jest": "^28.0.2",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.105.4",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^5.10.0"
  },
  "build": {
    "productName": "Captivate 2",
    "appId": "com.sailingtomars.captivate2",
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll,so,dylib,exe}",
      "**/node_modules/ffmpeg-static/**",
      "dist/main/lighting3dPreviewWorker.js"
    ],
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "icons/512x512.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "npmRebuild": false,
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "spensbot",
      "repo": "captivate",
      "vPrefixedTagName": true
    }
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/*"
    ],
    "logLevel": "quiet"
  },
  "engines": {
    "node": ">=25.9.0",
    "npm": ">=11.11.0"
  },
  "overrides": {
    "@electron/rebuild": {
      "node-gyp": "12.2.0"
    }
  }
}
