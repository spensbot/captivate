{
  "files.associations": {
    ".eslintrc": "jsonc",
    ".prettierrc": "jsonc",
    ".eslintignore": "ignore"
  },

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "html",
    "typescriptreact"
  ],

  "javascript.validate.enable": false,
  "javascript.format.enable": false,
  "typescript.format.enable": false,

  "search.exclude": {
    ".git": true,
    ".eslintcache": true,
    ".erb/dll": true,
    "release/{build,app/dist}": true,
    "node_modules": true,
    "npm-debug.log.*": true,
    "test/**/__snapshots__": true,
    "package-lock.json": true,
    "*.{css,sass,scss}.d.ts": true
  },
  "prettier.semi": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Optional Windows profile: run `npm run setup:local-cursor-node` once (creates gitignored scripts/cursor-terminal-init.ps1). See README — Developers.
  "terminal.integrated.profiles.windows": {
    "Captivate local Node": {
      "path": "powershell.exe",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/cursor-terminal-init.ps1"
      ],
      "icon": "terminal-powershell"
    }
  }
}
