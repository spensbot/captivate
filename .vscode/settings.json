{
  "terminal.integrated.defaultProfile.windows": "Captivate Node",
  "terminal.integrated.automationProfile.windows": {
    "path": "powershell.exe",
    "args": [
      "-NoExit",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "${workspaceFolder}/scripts/cursor-terminal-init.ps1"
    ]
  },
  "terminal.integrated.profiles.windows": {
    "Captivate Node": {
      "path": "powershell.exe",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/cursor-terminal-init.ps1"
      ],
      "icon": "terminal-powershell"
    }
  },

  "files.associations": {
    ".eslintrc": "jsonc",
    ".prettierrc": "jsonc",
    ".eslintignore": "ignore"
  },

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "html",
    "typescriptreact"
  ],

  "javascript.validate.enable": false,
  "javascript.format.enable": false,
  "typescript.format.enable": false,

  "search.exclude": {
    ".git": true,
    ".eslintcache": true,
    ".erb/dll": true,
    "release/{build,app/dist}": true,
    "node_modules": true,
    "npm-debug.log.*": true,
    "test/**/__snapshots__": true,
    "package-lock.json": true,
    "*.{css,sass,scss}.d.ts": true
  },
  "prettier.semi": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode"
}
